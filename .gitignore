# Environnements virtuels
.venv/
venv/
env/

# Python compilé et caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuration locale et secrets
.env
.env.*
!.env.example

# Fichiers temporaires et sorties locales
*.tmp
*.temp
*.log
*.bak
*.swp
.DS_Store
Thumbs.db

# Données sources : autoriser uniquement le jeu fictif explicitement approuvé
data/raw/**
!data/raw/.gitkeep
!data/raw/stages_cleaned2.xlsx

# Données intermédiaires : autoriser uniquement le référentiel fictif approuvé
data/interim/**
!data/interim/.gitkeep
!data/interim/geographic_reference.csv
data/processed/**
!data/processed/.gitkeep

# Sorties locales d'outils et de tableaux de bord
outputs/
reports/
